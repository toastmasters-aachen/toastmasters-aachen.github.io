---
import type { PageContent } from "../lib/content";

interface Props {
  content: PageContent;
}

const { content } = Astro.props;
---
<main class="site-main legal-page">
    <div class="legal-container" style="max-width: 800px; margin: 0 auto; padding: 40px 20px;">
        <span class="badge">{content.text.legalInfo}</span>
        <h1 style="font-size: 2.5rem; margin-bottom: 24px; color: var(--tm-navy-dark);">{content.text.imprint}</h1>
        
        <div class="legal-card" style="background: var(--tm-card-bg); border: 1px solid var(--tm-line); border-radius: var(--radius-md); padding: 40px; box-shadow: var(--shadow-soft); color: var(--tm-text); line-height: 1.7;">
            
            <h2 style="font-size: 1.5rem; margin-top: 0; margin-bottom: 16px; color: var(--tm-navy-dark);">{content.text.informationInAccordanceWith5TMG}</h2>
            <p style="margin-bottom: 24px;">
                <strong>Toastmasters Aachen e. V.</strong><br>
                Grachtstr. 29<br>
                52134 Herzogenrath
            </p>

            <p style="margin-bottom: 24px;">
                <strong>{content.text.registerOfAssociations}</strong> VR 5558<br>
                <strong>{content.text.registerCourt}</strong> Amtsgericht Aachen
            </p>

            <p style="margin-bottom: 24px;">
                <strong>{content.text.representedBy}</strong> Yuliya Kobuk
            </p>

            <hr style="border: 0; border-top: 1px solid var(--tm-line); margin: 32px 0;">

            <h2 style="font-size: 1.5rem; margin-bottom: 16px; color: var(--tm-navy-dark);">{content.text.contact}</h2>
            <p style="margin-bottom: 24px;">
                <strong>E-Mail:</strong> <a href="mailto:info@aachen-toastmasters.de" style="color: var(--tm-blue); text-decoration: underline; font-weight: 700;">info@aachen-toastmasters.de</a>
            </p>

            <hr style="border: 0; border-top: 1px solid var(--tm-line); margin: 32px 0;">

            <h2 style="font-size: 1.5rem; margin-bottom: 16px; color: var(--tm-navy-dark);">{content.text.personResponsibleForEditorialContent}</h2>
            <p style="margin-bottom: 24px;">
                Yuliya Kobuk<br>
                Grachtstr. 29<br>
                52134 Herzogenrath
            </p>

            <hr style="border: 0; border-top: 1px solid var(--tm-line); margin: 32px 0;">

            <h2 style="font-size: 1.5rem; margin-bottom: 16px; color: var(--tm-navy-dark);">{content.text.consumerDisputeResolutionUniversalArbitrationBoard}</h2>
            <p style="margin-bottom: 0;">
                {content.text.weAreNotWillingOrObligedTo}
            </p>

            <p style="margin-top: 32px; font-size: 0.85rem; color: var(--tm-muted); margin-bottom: 0;">
                Quelle: eRecht24
            </p>
        </div>
    </div>
</main>
